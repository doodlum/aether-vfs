;; As a library (a :local/root or git dependency), the Java helpers under
;; java/ are compiled by `clojure -X:deps prep` (the :build alias's javac).
{:paths ["src" "resources" "target/classes"]
 :deps/prep-lib {:alias :build :fn javac :ensure "target/classes"}

 :deps {org.clojure/clojure {:mvn/version "1.13.0-alpha9"}
        com.cnuernber/charred {:mvn/version "1.043"}
        in.dragonbra/javasteam {:mvn/version "1.8.0"}
        org.tukaani/xz {:mvn/version "1.12"}}

 :aliases
 {;; compile java/ (the ring's atomics and kernel32 downcalls) into target/classes
  ;;   clojure -T:build javac
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
          :ns-default build}

  ;; serve the benchmark fixture
  ;;   clojure -M:serve
  :serve {:main-opts ["-m" "aether.director.main"]
          :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-XX:+UseZGC"]}

  ;; launch a program under the director (see aether.director.run)
  :run {:main-opts ["-m" "aether.director.run"]
        :jvm-opts  ["--enable-native-access=ALL-UNNAMED" "-XX:+UseZGC"]}

  ;;   clojure -M:test
  :test {:extra-paths ["test"]
         :extra-deps  {lambdaisland/kaocha {:mvn/version "1.91.1392"}
                       org.clojure/test.check {:mvn/version "1.1.1"}}
         :jvm-opts    ["--enable-native-access=ALL-UNNAMED"]
         :main-opts   ["-m" "kaocha.runner"]}}}
